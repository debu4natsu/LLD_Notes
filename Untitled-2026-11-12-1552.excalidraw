      "updated": 1794762202922,
      "created": 1794762073783,
      "link": null,
      "locked": false,
      "text": "class BankAccount {\n\nprivate int balance;\n\npublic void deposit(int amount) {\n        balance += amount;\n}\n\npublic void withDraw(int amount) {\n    if(balance < amount)\n        throw new InvalidTransaction();\n    balance -= amount;\n}\n\n}",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class BankAccount {\n\nprivate int balance;\n\npublic void deposit(int amount) {\n        balance += amount;\n}\n\npublic void withDraw(int amount) {\n    if(balance < amount)\n        throw new InvalidTransaction();\n    balance -= amount;\n}\n\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
