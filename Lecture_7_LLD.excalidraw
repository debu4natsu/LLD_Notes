      "frameId": null,
      "index": "b3a",
      "roundness": null,
      "seed": 1404581525,
      "version": 366,
      "versionNonce": 1009512629,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795409156262,
      "created": 1795408894830,
      "link": null,
      "locked": false,
      "text": "BankAccount ba = new BankAccount(new FixedDepositAccount());\nba.deposit(100);\nba.withdraw(50); --> this particular function will not work for\nFixedDepositAccount() class, eventually breaking the LSP. ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BankAccount ba = new BankAccount(new FixedDepositAccount());\nba.deposit(100);\nba.withdraw(50); --> this particular function will not work for FixedDepositAccount() class, eventually breaking the LSP. ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "jlFB12nBG4EJb7EaPlxqu",
      "type": "text",
      "x": 2000.743023643535,
      "y": 24603.51830735435,
      "width": 481.5333251953125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3b",
      "roundness": null,
      "seed": 374132629,
      "version": 381,
      "versionNonce": 1854207862,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "d0wPgWin3hnJ3RPcQdrMy",
          "type": "arrow"
        }
      ],
      "updated": 1795410774378,
      "created": 1795409087211,
      "link": null,
      "locked": false,
      "text": "Client ko pta hi nhi tha ki apne aisa koe Account\nintroduce kiya hai, mtlb client ka promise tut gya.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Client ko pta hi nhi tha ki apne aisa koe Account\nintroduce kiya hai, mtlb client ka promise tut gya.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "uwTi3iZWPiO7L8UdNP2tL",
      "type": "text",
      "x": 1863.7920832303187,
      "y": 24449.81812059428,
      "width": 800,
      "height": 125,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3c",
      "roundness": null,
      "seed": 889835323,
      "version": 392,
      "versionNonce": 429368309,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795409597494,
      "created": 1795409215092,
      "link": null,
      "locked": false,
      "text": "LSP hame kya bolta hai, agr aap parent class ki jagah child bhi pass krte ho to\nhamare client ko dikkat nhi honi chaiye.\n\nSaving aur Salary Account me dikkat nhi hogi kyuki, deposit aur withdraw dono\npossible hai, but FixedDeposit Account me withdraw possible nhi hai",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LSP hame kya bolta hai, agr aap parent class ki jagah child bhi pass krte ho to\nhamare client ko dikkat nhi honi chaiye.\n\nSaving aur Salary Account me dikkat nhi hogi kyuki, deposit aur withdraw dono possible hai, but FixedDeposit Account me withdraw possible nhi hai",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "CgQHSdj4P5wRXQVKjIn9h",
      "type": "text",
      "x": 1698.41562666364,
      "y": 24814.544693796335,
      "width": 464.6833190917969,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3d",
      "roundness": null,
      "seed": 1147860662,
      "version": 356,
      "versionNonce": 1670658934,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "d0wPgWin3hnJ3RPcQdrMy",
          "type": "arrow"
        }
      ],
      "updated": 1795410806819,
      "created": 1795410611605,
      "link": null,
      "locked": false,
      "text": "class Client {\n\n    BankAccount ba;\n\n    public Client(BankAccount ba) {\n        this.ba = ba;\n    }\n    public void withdrawMoney(double amount) {\n        if(ba instanceOf FixedDepositAccount) {\n            //not supported\n        }\n        else {\n            ba.withdraw(amount);\n        }\n    }\n}",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Client {\n\n    BankAccount ba;\n\n    public Client(BankAccount ba) {\n        this.ba = ba;\n    }\n    public void withdrawMoney(double amount) {\n        if(ba instanceOf FixedDepositAccount) {\n            //not supported\n        }\n        else {\n            ba.withdraw(amount);\n        }\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
