    {
      "id": "7IW58mUqPtkMVo7ofDj-G",
      "type": "text",
      "x": 1854.2156770840231,
      "y": 24246.13453525798,
      "width": 800,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
