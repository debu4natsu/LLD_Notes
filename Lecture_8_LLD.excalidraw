      "link": null,
      "locked": false,
      "text": "class OrderService {\n    \n    OrderRepository or = new OrderRepository();\n    PaymentService ps = new PaymentService();\n    EmailService es = new EmailService();\n\n    void placeOrder() {\n        //validate\n        ps.pay();\n        \n        or.pay();\n\n        es.sendEmail();\n    }\n}",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class OrderService {\n    \n    OrderRepository or = new OrderRepository();\n    PaymentService ps = new PaymentService();\n    EmailService es = new EmailService();\n\n    void placeOrder() {\n        //validate\n        ps.pay();\n        \n        or.pay();\n\n        es.sendEmail();\n    }\n}",
