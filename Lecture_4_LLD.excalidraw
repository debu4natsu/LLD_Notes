    {
      "id": "7001gVgM6L27lDsdpJ4cn",
      "type": "text",
      "x": 435.9180953841586,
      "y": 20601.481642160972,
      "width": 1170.4170019579187,
      "height": 720,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bA7",
      "roundness": null,
      "seed": 1190575906,
      "version": 358,
      "versionNonce": 144787198,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794977663976,
      "created": 1794977466801,
      "link": null,
      "locked": false,
      "text": "if(!student.isActive()) {\n    throw new IllegalStateException(\"user is not active\");\n}\n\nif(alreadyEnrolled){\n    throw new IllegalStateException(\"user is already enrolled\");\n}\n\n\nif(enrolledCount >= 5){\n    throw new IllegalStateException(\"user has taken max\ncourses\");\n}\n\nenrollmentRespository.save(enrollment);\n",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "if(!student.isActive()) {\n    throw new IllegalStateException(\"user is not active\");\n}\n\nif(alreadyEnrolled){\n    throw new IllegalStateException(\"user is already enrolled\");\n}\n\n\nif(enrolledCount >= 5){\n    throw new IllegalStateException(\"user has taken max courses\");\n}\n\nenrollmentRespository.save(enrollment);\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
