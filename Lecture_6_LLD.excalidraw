      "updated": 1795327466596,
      "created": 1795287725804,
      "link": null,
      "locked": false,
      "text": "interface NotificationService {\n    void send(String message);\n}\n\nclass EmailService implements NotificationService {\n    @Override\n    public void send(String message) {\n        // logic to send email notification\n        System.out.println(\"Email sent: \" + message);\n    }\n}\n\nclass WhatsAppService implements NotificationService {\n    @Override\n    public void send(String message) {\n        // logic to send WhatsApp notification\n        System.out.println(\"WhatsApp sent: \" + message);\n    }\n}\n\nclass InstagramService implements NotificationService {\n    @Override\n    public void send(String message) {\n        // logic to send Instagram notification\n        System.out.println(\"Instagram sent: \" + message);\n    }\n}\n\nclass OrderService {\n    private final NotificationService ns;\n\n    public OrderService(NotificationService ns) {\n        this.ns = ns;\n    }\n\n    void placeOrder() {\n        // logic to place order\n        ns.send(\"Order placed\");\n    }\n}\n\npublic class Main {\n    public static void main(String[] args) {\n        OrderService emailOrderService = new OrderService(new EmailService());\n        emailOrderService.placeOrder();\n\n        OrderService whatsAppOrderService = new OrderService(new WhatsAppService());\n        whatsAppOrderService.placeOrder();\n\n        OrderService instagramOrderService = new OrderService(new InstagramService());\n        instagramOrderService.placeOrder();\n    }\n}",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "interface NotificationService {\n    void send(String message);\n}\n\nclass EmailService implements NotificationService {\n    @Override\n    public void send(String message) {\n        // logic to send email notification\n        System.out.println(\"Email sent: \" + message);\n    }\n}\n\nclass WhatsAppService implements NotificationService {\n    @Override\n    public void send(String message) {\n        // logic to send WhatsApp notification\n        System.out.println(\"WhatsApp sent: \" + message);\n    }\n}\n\nclass InstagramService implements NotificationService {\n    @Override\n    public void send(String message) {\n        // logic to send Instagram notification\n        System.out.println(\"Instagram sent: \" + message);\n    }\n}\n\nclass OrderService {\n    private final NotificationService ns;\n\n    public OrderService(NotificationService ns) {\n        this.ns = ns;\n    }\n\n    void placeOrder() {\n        // logic to place order\n        ns.send(\"Order placed\");\n    }\n}\n\npublic class Main {\n    public static void main(String[] args) {\n        OrderService emailOrderService = new OrderService(new EmailService());\n        emailOrderService.placeOrder();\n\n        OrderService whatsAppOrderService = new OrderService(new WhatsAppService());\n        whatsAppOrderService.placeOrder();\n\n        OrderService instagramOrderService = new OrderService(new InstagramService());\n        instagramOrderService.placeOrder();\n    }\n}",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
